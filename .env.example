# Copy to .env. NEVER commit .env (it is in .gitignore).
OPENROUTER_API_KEY=

# Generators to compare (provider:model). With OpenRouter, model = OpenRouter slug.
# Check slugs still exist: python scripts/check_openrouter.py
GEN_MODELS=openrouter:openai/gpt-4o-mini,openrouter:mistralai/mistral-small-3.2-24b-instruct
# Judge from a DIFFERENT family than the generators (self-enhancement bias control).
JUDGE_MODEL=openrouter:anthropic/claude-3.5-haiku
